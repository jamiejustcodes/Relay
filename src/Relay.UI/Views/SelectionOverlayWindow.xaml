<Window x:Class="Relay.UI.Views.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Relay.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
        Title="Relay Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        MouseDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseUp="OnMouseUp"
        KeyDown="OnKeyDown">

    <Grid x:Name="RootGrid" Background="#01000000">
        <!-- Mask with Cutout Hole -->
        <Path Fill="{StaticResource OverlayDimBrush}">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="ScreenBoundsGeometry" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="SelectionHoleGeometry" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <!-- Selection Rectangle Frame & Glow -->
        <Canvas>
            <Border x:Name="SelectionBorder"
                    Canvas.Left="{Binding SelectionLeft}"
                    Canvas.Top="{Binding SelectionTop}"
                    Width="{Binding SelectionWidth}"
                    Height="{Binding SelectionHeight}"
                    BorderBrush="{StaticResource SelectionBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    Visibility="{Binding IsSelecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect Color="#6366F1" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                </Border.Effect>

                <!-- Dimension Badge -->
                <Grid>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,6,6"
                            Background="#D90F1117"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2">
                        <TextBlock Text="{Binding DimensionText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Floating Prompt Bar (Ctrl + Shift + Space) -->
            <Border x:Name="PromptBar"
                    Canvas.Left="{Binding PromptBarLeft}"
                    Canvas.Top="{Binding PromptBarTop}"
                    Width="{Binding PromptBarWidth}"
                    Visibility="{Binding IsPromptBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#FA131722"
                    BorderBrush="{StaticResource AccentPrimaryBrush}"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="10,8">
                <Border.Effect>
                    <DropShadowEffect Color="#6366F1" BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="✦"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryHoverBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,10,0" />

                    <TextBox Grid.Column="1"
                             x:Name="PromptTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             FontSize="13"
                             Padding="10,8"
                             KeyDown="OnPromptKeyDown"
                             ToolTip="Type your question or instructions (Press Enter to send)..." />

                    <Button Grid.Column="2"
                            Style="{StaticResource ModernActionButtonStyle}"
                            Click="OnSendPromptClick"
                            Height="36"
                            Padding="12,0"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ask AI" FontWeight="Bold" FontSize="12" Margin="0,0,6,0" />
                            <Border Background="#25FFFFFF" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="↵" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Bottom Instruction Toolbar -->
            <Border Canvas.Left="0" Canvas.Top="0"
                    x:Name="InstructionBar"
                    HorizontalAlignment="Center"
                    Background="#E6131722"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18,8">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✦ Relay" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="InstructionText" Text="Drag region to analyze" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="Space  Full Screen" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="Enter  Confirm" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Esc  Cancel" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
