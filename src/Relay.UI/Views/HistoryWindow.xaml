<ui:FluentWindow x:Class="Relay.UI.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Relay.UI.ViewModels"
        xmlns:controls="clr-namespace:Relay.UI.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
        Title="Relay — History"
        Icon="/Assets/relay.ico"
        WindowStartupLocation="CenterScreen"
        Width="960" Height="680"
        MinWidth="720" MinHeight="500"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Window Resources (ListItem Card Style)                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Window.Resources>
        <!-- History List Item Card Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#08FFFFFF"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#12FFFFFF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource RelayAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource RelayAccentSubtleBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource RelayAccentBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Main Layout                                                -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Custom TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 0: Custom Title Bar (Reference standard)                -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <ui:TitleBar Grid.Row="0"
                     Title=""
                     ShowMaximize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <!-- Purple Diamond Logo -->
                    <Border Width="24" Height="24"
                            Background="{StaticResource RelayAccentBrush}"
                            CornerRadius="6">
                        <TextBlock Text="✦"
                                   Foreground="#FFFFFF"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Wordmark -->
                    <TextBlock Text="Relay"
                               Style="{StaticResource RelayDisplayTextStyle}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />

                    <!-- Window Subtitle -->
                    <TextBlock Text="• History"
                               Style="{StaticResource RelayCaptionTextStyle}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Opacity="0.7" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 1: Content Area                                        -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <Grid Grid.Row="1" Margin="{StaticResource RelayPagePadding}">
            <Grid.RowDefinitions>
                <!-- 0: Page Header Row -->
                <RowDefinition Height="Auto" />
                <!-- 1: Master-Detail Split Grid -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 0: Page Header & Action Buttons -->
            <Grid Grid.Row="0" Margin="0,2,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Analysis History"
                               Style="{StaticResource RelayHeroTextStyle}" />
                    <TextBlock Text="Search and review previous screen analyses, explanations, and code answers."
                               Style="{StaticResource RelaySubtitleTextStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Header Actions (WPF-UI Secondary Buttons) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary"
                               Command="{Binding ClearAllCommand}"
                               Padding="14,6"
                               Margin="0,0,8,0"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" Margin="0,0,6,0" />
                            <TextBlock Text="Clear All" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary"
                               Click="OnCloseClick"
                               Padding="14,6"
                               Cursor="Hand">
                        <TextBlock Text="Close" FontSize="12" VerticalAlignment="Center" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- 1: Master-Detail Split View -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Master: History List -->
                    <ColumnDefinition Width="350" />
                    <!-- Gap -->
                    <ColumnDefinition Width="14" />
                    <!-- Detail: Selected Item View -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Search & History List Card -->
                <Border Grid.Column="0"
                        Style="{StaticResource RelayCardStyle}"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search Input Field -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnSearchKeyDown"
                                     Height="34"
                                     ToolTip="Search history... (Press Enter)" />
                        </Grid>

                        <!-- Empty State in List -->
                        <Border Grid.Row="1"
                                Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Padding="20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📭" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="No history yet"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Press Ctrl + Space anywhere on Windows to analyze your screen."
                                           Style="{StaticResource RelayCaptionTextStyle}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- List of History Items -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem}"
                                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Line: Intent Tag Pill & Timestamp -->
                                        <Grid Grid.Row="0" Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Intent Pill -->
                                            <Border Grid.Column="0"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding Intent, Converter={StaticResource IntentToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding Intent}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Intent, Converter={StaticResource IntentToForegroundConverter}}" />
                                            </Border>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Timestamp, StringFormat='{}{0:MM/dd HH:mm}'}"
                                                       Style="{StaticResource RelayCaptionTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Middle Line: Title -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,3" />

                                        <!-- Bottom Line: App & Summary snippet -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding ApplicationName}"
                                                   Style="{StaticResource RelayCaptionTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Right Column: Detail View Card -->
                <Border Grid.Column="2"
                        Style="{StaticResource RelayCardStyle}"
                        Padding="16">
                    <Grid>
                        <!-- Empty Detail State (No selection) -->
                        <Border Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}, ConverterParameter=Invert}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Select an analysis from the list"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="View full AI answers, generated code, and screen context."
                                           Style="{StaticResource RelayCaptionTextStyle}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Item Details View -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}"
                                      Padding="0,0,6,0">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Top Badge, Metadata & Actions Bar -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Category Pill + App Name + Timestamp -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Category Intent Pill -->
                                        <Border Background="{Binding SelectedItem.Intent, Converter={StaticResource IntentToBrushConverter}}"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedItem.Intent}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding SelectedItem.Intent, Converter={StaticResource IntentToForegroundConverter}}" />
                                        </Border>

                                        <!-- App Origin Badge -->
                                        <Border Style="{StaticResource RelayKbdBadgeStyle}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedItem.ApplicationName}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Text="•" Foreground="{StaticResource RelayTextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                                        <!-- Timestamp -->
                                        <TextBlock Text="{Binding SelectedItem.Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   Style="{StaticResource RelayCaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Right: Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button Appearance="Secondary"
                                                   Command="{Binding CopySelectedContentCommand}"
                                                   Padding="12,5"
                                                   Margin="0,0,6,0"
                                                   Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Copy Markdown" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button Appearance="Secondary"
                                                   Command="{Binding DeleteItemCommand}"
                                                   CommandParameter="{Binding SelectedItem}"
                                                   Foreground="#F43F5E"
                                                   Padding="8,5"
                                                   ToolTip="Delete this record"
                                                   Cursor="Hand">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Title (RelayDetailTitleTextStyle) -->
                                <TextBlock Text="{Binding SelectedItem.Title}"
                                           Style="{StaticResource RelayDetailTitleTextStyle}"
                                           Margin="0,0,0,10" />

                                <!-- Optional User Prompt / Question (Accent Badge Style) -->
                                <Border Background="{StaticResource RelayAccentSubtleBrush}"
                                        BorderBrush="#406366F1"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        Margin="0,0,0,10"
                                        Visibility="{Binding SelectedItem.UserQuestion, Converter={StaticResource NullToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💬 " FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedItem.UserQuestion}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Executive Summary Card -->
                                <Border Background="#08FFFFFF"
                                        BorderBrush="#15FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,14"
                                        Visibility="{Binding SelectedItem.Summary, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding SelectedItem.Summary}"
                                               Style="{StaticResource RelaySubtitleTextStyle}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               LineHeight="19" />
                                </Border>

                                <!-- Thumbnail Preview (if present) -->
                                <Border Background="#08FFFFFF"
                                        BorderBrush="#15FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="6"
                                        Margin="0,0,0,14"
                                        HorizontalAlignment="Left"
                                        MaxHeight="200"
                                        Visibility="{Binding SelectedItem.ThumbnailBase64, Converter={StaticResource NullToVis}}">
                                    <Image Source="{Binding SelectedItem.ThumbnailBase64, Converter={StaticResource Base64ToImageConverter}}"
                                           Stretch="Uniform"
                                           MaxHeight="180" />
                                </Border>

                                <!-- Full Response Markdown Viewer -->
                                <controls:MarkdownViewerControl Markdown="{Binding SelectedItem.MarkdownResponse}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
