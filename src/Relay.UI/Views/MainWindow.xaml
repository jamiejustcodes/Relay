<ui:FluentWindow x:Class="Relay.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Relay.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="Relay — AI Desktop Assistant"
        Icon="/Assets/relay.ico"
        WindowStartupLocation="CenterScreen"
        Width="560" Height="420"
        MinWidth="480" MinHeight="360"
        ResizeMode="CanMinimize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Main Layout                                                -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Custom TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 0: Custom Title Bar                                    -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <ui:TitleBar Grid.Row="0"
                     Title=""
                     ShowMaximize="False">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <!-- Purple Diamond Logo (preserved exactly as-is) -->
                    <Border Width="24" Height="24"
                            Background="{StaticResource RelayAccentBrush}"
                            CornerRadius="6">
                        <TextBlock Text="✦"
                                   Foreground="#FFFFFF"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Wordmark -->
                    <TextBlock Text="Relay"
                               Style="{StaticResource RelayDisplayTextStyle}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />

                    <!-- Pulsing Status Dot — integrated next to logo -->
                    <Ellipse x:Name="StatusDot"
                             Width="7" Height="7"
                             Margin="10,1,0,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource RelayReadyBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReady}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource RelayWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.35"
                                                         Duration="0:0:1.2"
                                                         AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <!-- Status text (compact, inline) -->
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource RelayCaptionTextStyle}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Opacity="0.7" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 1: Content Area                                        -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <Grid Grid.Row="1" Margin="{StaticResource RelayPagePadding}">
            <Grid.RowDefinitions>
                <!-- 0: Hero Action Zone (dominant) -->
                <RowDefinition Height="*" />
                <!-- 1: Compact Status Strip -->
                <RowDefinition Height="Auto" />
                <!-- 2: Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- Hero Action Zone                                   -->
            <!-- The primary action dominates the layout             -->
            <!-- ═══════════════════════════════════════════════════ -->

            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">

                <!-- Hero Heading -->
                <TextBlock Text="Capture Screen"
                           Style="{StaticResource RelayHeroTextStyle}"
                           HorizontalAlignment="Center" />

                <!-- Subtitle -->
                <TextBlock Text="Drag a selection over anything to instantly understand it."
                           Style="{StaticResource RelaySubtitleTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,6,0,0"
                           MaxWidth="360" />

                <!-- Primary / Secondary Button Pair -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0">

                    <!-- Primary: Quick Capture (dominant) -->
                    <ui:Button Appearance="Primary"
                               Command="{Binding TriggerCaptureCommand}"
                               Padding="20,12"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Screenshot24"
                                          FontSize="18"
                                          Margin="0,0,8,0" />
                            <TextBlock Text="Quick Capture"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource RelayKbdBadgeStyle}"
                                    Margin="10,0,0,0">
                                <TextBlock Text="{Binding ActiveHotkey}"
                                           FontSize="10"
                                           Opacity="0.8"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </ui:Button>

                    <!-- Secondary: Ask with Prompt -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding TriggerPromptCaptureCommand}"
                               Padding="14,10"
                               Margin="10,0,0,0"
                               FontSize="13"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Chat24"
                                          FontSize="16"
                                          Margin="0,0,6,0" />
                            <TextBlock Text="Ask with Prompt"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource RelayKbdBadgeStyle}"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding ActivePromptHotkey}"
                                           FontSize="10"
                                           Opacity="0.7"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- Compact Status Strip                               -->
            <!-- Consolidates Model / Shortcuts / Privacy into one  -->
            <!-- quiet line of metadata                              -->
            <!-- ═══════════════════════════════════════════════════ -->

            <Border Grid.Row="1"
                    Margin="{StaticResource RelayStatusStripMargin}"
                    Background="#08FFFFFF"
                    CornerRadius="8"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <!-- AI Model -->
                    <ui:SymbolIcon Symbol="Bot24"
                                  FontSize="14"
                                  Foreground="{StaticResource RelayTextDimBrush}" />
                    <TextBlock Text="{Binding ActiveModel}"
                               Style="{StaticResource RelayCaptionTextStyle}"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center" />

                    <!-- Separator -->
                    <Ellipse Width="3" Height="3"
                             Fill="{StaticResource RelayTextMutedBrush}"
                             Margin="14,0"
                             VerticalAlignment="Center" />

                    <!-- Shortcut -->
                    <ui:SymbolIcon Symbol="Keyboard24"
                                  FontSize="14"
                                  Foreground="{StaticResource RelayTextDimBrush}" />
                    <TextBlock Style="{StaticResource RelayCaptionTextStyle}"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center">
                        <Run Text="{Binding ActiveHotkey, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Separator -->
                    <Ellipse Width="3" Height="3"
                             Fill="{StaticResource RelayTextMutedBrush}"
                             Margin="14,0"
                             VerticalAlignment="Center" />

                    <!-- Privacy -->
                    <ui:SymbolIcon Symbol="ShieldCheckmark24"
                                  FontSize="14"
                                  Foreground="{StaticResource RelayTextDimBrush}" />
                    <TextBlock Text="DPAPI Encrypted"
                               Style="{StaticResource RelayCaptionTextStyle}"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- Footer Actions                                     -->
            <!-- ═══════════════════════════════════════════════════ -->

            <Grid Grid.Row="2" Margin="{StaticResource RelayFooterMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Settings -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding OpenSettingsCommand}"
                               Padding="10,6"
                               Margin="0,0,6,0"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="15" />
                            <TextBlock Text="Settings"
                                       FontSize="12"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- History -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding OpenHistoryCommand}"
                               Padding="10,6"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="15" />
                            <TextBlock Text="History"
                                       FontSize="12"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!-- Minimize to Tray -->
                <ui:Button Grid.Column="1"
                           Appearance="Secondary"
                           Click="OnMinimizeToTrayClick"
                           Padding="10,6"
                           Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowMinimize24" FontSize="15" />
                        <TextBlock Text="Minimize to Tray"
                                   FontSize="12"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
