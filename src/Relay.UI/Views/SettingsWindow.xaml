<Window x:Class="Relay.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Relay.UI.ViewModels"
        xmlns:controls="clr-namespace:Relay.UI.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Relay Settings"
        Icon="/Assets/relay.ico"
        WindowStartupLocation="CenterScreen"
        Width="580" Height="760"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <controls:StatusMessageToBrushConverter x:Key="StatusMessageToBrushConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Body -->
            <RowDefinition Height="*" />
            <!-- 2: Footer / Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" Background="{StaticResource AccentPrimaryBrush}" CornerRadius="6" Margin="0,0,10,0">
                    <TextBlock Text="⚙" Foreground="#FFFFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Relay Settings" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Configure AI models, global hotkeys, privacy, and system preferences." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="38,4,0,0" />
        </StackPanel>

        <!-- 1: Body Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- Card 0: AI Provider Toggle                            -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🧠 AI Provider" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Choose between Google Gemini (cloud) or a local AI running on your PC." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <!-- Two-Button Toggle -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Gemini Button -->
                            <Button Grid.Column="0" Command="{Binding SelectGeminiCommand}" Cursor="Hand" Height="48">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="GeminiBorder"
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="☁️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="GeminiTitle" Text="Gemini Cloud" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock x:Name="GeminiSubtitle" Text="Google AI • API Key" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsGeminiSelected}" Value="True">
                                                <Setter TargetName="GeminiBorder" Property="Background" Value="#306366F1" />
                                                <Setter TargetName="GeminiBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                                <Setter TargetName="GeminiBorder" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="GeminiTitle" Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="GeminiSubtitle" Property="Foreground" Value="{StaticResource AccentPrimaryHoverBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGeminiSelected}" Value="False">
                                                <Setter TargetName="GeminiBorder" Property="Background" Value="#10FFFFFF" />
                                                <Setter TargetName="GeminiBorder" Property="BorderBrush" Value="{StaticResource GlassBorderSubtleBrush}" />
                                                <Setter TargetName="GeminiBorder" Property="BorderThickness" Value="1" />
                                                <Setter TargetName="GeminiTitle" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Setter TargetName="GeminiSubtitle" Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="GeminiBorder" Property="Background" Value="#256366F1" />
                                                <Setter TargetName="GeminiTitle" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Ollama Button -->
                            <Button Grid.Column="2" Command="{Binding SelectOllamaCommand}" Cursor="Hand" Height="48">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="OllamaBorder"
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🖥️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="OllamaTitle" Text="Local AI (Ollama)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock x:Name="OllamaSubtitle" Text="Private • No API Key" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsOllamaSelected}" Value="True">
                                                <Setter TargetName="OllamaBorder" Property="Background" Value="#3010B981" />
                                                <Setter TargetName="OllamaBorder" Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                                <Setter TargetName="OllamaBorder" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="OllamaTitle" Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="OllamaSubtitle" Property="Foreground" Value="{StaticResource AccentEmeraldBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOllamaSelected}" Value="False">
                                                <Setter TargetName="OllamaBorder" Property="Background" Value="#10FFFFFF" />
                                                <Setter TargetName="OllamaBorder" Property="BorderBrush" Value="{StaticResource GlassBorderSubtleBrush}" />
                                                <Setter TargetName="OllamaBorder" Property="BorderThickness" Value="1" />
                                                <Setter TargetName="OllamaTitle" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Setter TargetName="OllamaSubtitle" Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="OllamaBorder" Property="Background" Value="#2510B981" />
                                                <Setter TargetName="OllamaTitle" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- Card 1: Gemini AI Credentials (visible when Gemini)    -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding IsGeminiSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="✦ Gemini AI API Key" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Your API key is encrypted locally using Windows DPAPI." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                     Style="{StaticResource SubtleActionButtonStyle}"
                                     Command="{Binding TestConnectionCommand}"
                                     Height="36"
                                     Content="Test Key" />
                        </Grid>

                        <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{Binding StatusMessage, Converter={StaticResource StatusMessageToBrushConverter}}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <!-- Model Selection -->
                        <TextBlock Text="Model Selection" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel}"
                                  Height="34" />
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- Card 1B: Local AI / Ollama (visible when Ollama)       -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding IsOllamaSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🖥️ Local AI Setup (Ollama)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Run AI vision models entirely on your PC. No data leaves your machine." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <!-- Ollama Server Status Badge -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Ollama Server:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#20F59E0B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOllamaRunning}" Value="True">
                                                <Setter Property="Background" Value="#2010B981" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding OllamaStatusText}" FontSize="12" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOllamaRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentEmeraldBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Button Style="{StaticResource SubtleActionButtonStyle}"
                                    Command="{Binding RefreshOllamaStatusCommand}"
                                    Content="↻ Refresh"
                                    Height="28"
                                    FontSize="11"
                                    Padding="8,2"
                                    Margin="0,0,6,0" />
                            <Button Style="{StaticResource SubtleActionButtonStyle}"
                                    Command="{Binding UninstallOllamaCommand}"
                                    Content="🗑 Uninstall Ollama"
                                    Foreground="#F43F5E"
                                    Height="28"
                                    FontSize="11"
                                    Padding="8,2"
                                    Visibility="{Binding IsOllamaInstalled, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Install Button (shown when not installed) -->
                        <StackPanel Margin="0,0,0,10">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOllamaInstalled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="#15F59E0B" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Ollama is not installed on this PC." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Click below to download and install Ollama automatically. It installs to your user profile — no admin rights needed." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Style="{StaticResource ModernActionButtonStyle}"
                                            Command="{Binding InstallOllamaCommand}"
                                            Content="⬇ Install Ollama"
                                            Height="36"
                                            HorizontalAlignment="Left"
                                            Padding="16,0" />
                                </StackPanel>
                            </Border>
                            <!-- Install Progress -->
                            <StackPanel Visibility="{Binding IsInstallingOllama, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Value="{Binding OllamaInstallProgress}" Maximum="100" Height="6" Margin="0,0,0,4"
                                             Foreground="{StaticResource AccentPrimaryBrush}" />
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{Binding StatusMessage, Converter={StaticResource StatusMessageToBrushConverter}}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Start Button (shown when installed but not running) -->
                        <StackPanel Margin="0,0,0,10">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsOllamaInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsOllamaRunning}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource ModernActionButtonStyle}"
                                    Command="{Binding StartOllamaCommand}"
                                    Content="▶ Start Ollama"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    Padding="16,0" />
                        </StackPanel>

                        <!-- Model Selection & Download (shown when running) -->
                        <StackPanel Visibility="{Binding IsOllamaRunning, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Vision Model:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Border CornerRadius="6" Padding="8,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#20F59E0B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedOllamaModelInstalled}" Value="True">
                                                    <Setter Property="Background" Value="#2010B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedModelStatusText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F59E0B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedOllamaModelInstalled}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentEmeraldBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding OllamaModels}"
                                          SelectedItem="{Binding SelectedOllamaModel}"
                                          IsEditable="True"
                                          Height="34"
                                          Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Command="{Binding PullModelCommand}"
                                        Content="⬇ Download Model"
                                        Height="34"
                                        Padding="12,0"
                                        Margin="0,0,6,0" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SubtleActionButtonStyle}"
                                        Command="{Binding DeleteModelCommand}"
                                        Content="🗑 Delete Model"
                                        Foreground="#F43F5E"
                                        Height="34"
                                        Padding="10,0"
                                        Visibility="{Binding IsSelectedOllamaModelInstalled, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- Notice shown if model is not installed on disk -->
                            <Border Background="#15F59E0B" BorderBrush="#35F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding IsSelectedOllamaModelInstalled, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <TextBlock Text="⚠️ This model is not downloaded yet. Click '⬇ Download Model' to download it (~4.5 GB) before using offline capture."
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Pull Progress -->
                            <StackPanel Visibility="{Binding IsPullingModel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <ProgressBar Value="{Binding OllamaPullProgress}" Maximum="100" Height="6" Margin="0,0,0,4"
                                             Foreground="{StaticResource AccentEmeraldBrush}" />
                                <TextBlock Text="{Binding OllamaPullStatus}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Status Message for Ollama -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{Binding StatusMessage, Converter={StaticResource StatusMessageToBrushConverter}}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Global Shortcuts -->
                <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="⌨ Global Keyboard Shortcuts" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Trigger instant screen captures or ask with typed prompts from anywhere on Windows." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <!-- Quick Capture Shortcut -->
                        <TextBlock Text="📷 Quick Capture (Auto-Analyze)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Modifiers" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableModifiers}" SelectedItem="{Binding HotkeyModifiers}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Key" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableKeys}" SelectedItem="{Binding HotkeyKey}" Height="34" />
                            </StackPanel>
                        </Grid>

                        <!-- Prompted Capture Shortcut -->
                        <TextBlock Text="💬 Ask with Prompt (Attached Input Box)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Modifiers" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableModifiers}" SelectedItem="{Binding PromptHotkeyModifiers}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Key" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableKeys}" SelectedItem="{Binding PromptHotkeyKey}" Height="34" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Features & Privacy -->
                <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🔒 Privacy &amp; Performance" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Control what gets analyzed and stored on your machine." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <CheckBox IsChecked="{Binding AutoRunOcr}" Content="Run offline Windows OCR on selection for instant text extraction" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding SaveHistory}" Content="Save query history in local SQLite database" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding SaveImagesInHistory}" Content="Save thumbnail images with history (disabled by default for privacy)" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding AutoSearchWeb}" Content="Allow automatic web search for products and errors" Margin="0,0,0,12" />

                        <!-- Excluded Apps -->
                        <TextBlock Text="Excluded Applications (Blacklist)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding NewExcludedApp, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"
                                     Margin="0,0,8,0"
                                     ToolTip="Enter executable name (e.g. 1Password, KeePass)" />
                            <Button Grid.Column="1"
                                     Style="{StaticResource SubtleActionButtonStyle}"
                                     Command="{Binding AddExcludedAppCommand}"
                                     Height="34"
                                     Padding="14,0"
                                     Content="Add App" />
                        </Grid>

                        <ListBox ItemsSource="{Binding ExcludedApplications}" MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCardBrush}"
                                            BorderBrush="{StaticResource GlassBorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="Medium"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource CloseWindowButtonStyle}"
                                                    Command="{Binding DataContext.RemoveExcludedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remove from blacklist"
                                                    Width="22" Height="22">
                                                <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Card 4: System & Background Startup -->
                <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🚀 System &amp; Background Startup" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Configure Relay to run silently in the system tray." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start Relay automatically on Windows login" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding StartMinimizedToTray}" Content="Start minimized to the 'Show hidden icons' tray" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding ShowTrayNotifications}" Content="Show tray notification banner when Relay launches" Margin="0,0,0,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 2: Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ModernActionButtonStyle}"
                    Command="{Binding SaveSettingsCommand}"
                    Content="Save Settings"
                    Width="120"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource SubtleActionButtonStyle}"
                    Click="OnCloseClick"
                    Content="Close"
                    Width="80" />
        </StackPanel>
    </Grid>
</Window>
