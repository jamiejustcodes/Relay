<Application x:Class="Relay.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Relay.UI.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <controls:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <controls:NullToVisibilityConverter x:Key="NullToVis" />
            <controls:CountToVisibilityConverter x:Key="CountToVis" />
            <controls:StatusMessageToBrushConverter x:Key="StatusMessageToBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
