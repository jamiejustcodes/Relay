<Application x:Class="Relay.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Relay.UI.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Styles/Controls.xaml" />
                <ResourceDictionary Source="/Styles/RelayTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <controls:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <controls:NullToVisibilityConverter x:Key="NullToVis" />
            <controls:CountToVisibilityConverter x:Key="CountToVis" />
            <controls:StatusMessageToBrushConverter x:Key="StatusMessageToBrushConverter" />
            <controls:IntentToBrushConverter x:Key="IntentToBrushConverter" />
            <controls:IntentToForegroundConverter x:Key="IntentToForegroundConverter" />
            <controls:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
