<Window x:Class="ScreenLens.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenLens.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="Relay — AI Desktop Assistant"
        WindowStartupLocation="CenterScreen"
        Width="640" Height="500"
        ResizeMode="NoResize"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0: Header & Status Badge -->
            <RowDefinition Height="Auto" />
            <!-- 1: Hero Capture Action Card -->
            <RowDefinition Height="Auto" />
            <!-- 2: Info & Status Grid -->
            <RowDefinition Height="*" />
            <!-- 3: Footer Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" Background="{StaticResource AccentPrimaryBrush}" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="✦" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Relay" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Instant visual AI intelligence for your Windows desktop." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="44,2,0,0" />
            </StackPanel>

            <!-- Status Indicator -->
            <Border Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="#1810B981"
                    BorderBrush="{StaticResource AccentEmeraldBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 1: Hero Capture Action Card -->
        <Border Grid.Row="1"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Capture Screen Selection" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="Drag a box over any window, text, code error, or product to immediately understand it."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="16" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource ModernActionButtonStyle}"
                        Command="{Binding TriggerCaptureCommand}"
                        Padding="18,12"
                        Height="44"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✦ Capture Now" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" />
                        <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding ActiveHotkey}" FontSize="11" />
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2: Info & Status Cards Grid -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Active Model -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource GlassBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="🤖 Active AI Model" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ActiveModel}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                    <TextBlock Text="Google Gemini Multimodal" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 2: Global Shortcut -->
            <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource GlassBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="⌨ Global Hotkey" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryHoverBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ActiveHotkey}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                    <TextBlock Text="Works anywhere in Windows" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 3: Privacy & Security -->
            <Border Grid.Column="4" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource GlassBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="🔒 Privacy Protection" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="Local DPAPI Encrypted" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                    <TextBlock Text="App Blacklist Active" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3: Footer Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SubtleActionButtonStyle}"
                        Command="{Binding OpenSettingsCommand}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" Margin="0,0,6,0" />
                        <TextBlock Text="Settings &amp; API Key" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SubtleActionButtonStyle}"
                        Command="{Binding OpenHistoryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕒" Margin="0,0,6,0" />
                        <TextBlock Text="History" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource SubtleActionButtonStyle}"
                    Click="OnMinimizeToTrayClick"
                    Content="Minimize to Tray" />
        </Grid>
    </Grid>
</Window>
