<Window x:Class="ScreenLens.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenLens.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Relay Settings"
        WindowStartupLocation="CenterScreen"
        Width="580" Height="680"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Body -->
            <RowDefinition Height="*" />
            <!-- 2: Footer / Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" Background="{StaticResource AccentPrimaryBrush}" CornerRadius="6" Margin="0,0,10,0">
                    <TextBlock Text="⚙" Foreground="#FFFFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Relay Settings" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Configure AI models, global hotkeys, privacy, and system preferences." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="38,4,0,0" />
        </StackPanel>

        <!-- 1: Body Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Card 1: Gemini AI Credentials -->
                <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="✦ Gemini AI API Key" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Your API key is encrypted locally using Windows DPAPI." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SubtleActionButtonStyle}"
                                    Command="{Binding TestConnectionCommand}"
                                    Height="36"
                                    Content="Test Key" />
                        </Grid>

                        <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource AccentEmeraldBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <!-- Model Selection -->
                        <TextBlock Text="Model Selection" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel}"
                                  Height="32"
                                  Background="{StaticResource BgInputBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Global Shortcut -->
                <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="⌨ Global Keyboard Shortcut" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Press this combination from anywhere on Windows to activate ScreenLens." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Modifiers" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableModifiers}" SelectedItem="{Binding HotkeyModifiers}" Height="32" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Key" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableKeys}" SelectedItem="{Binding HotkeyKey}" Height="32" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Features & Privacy -->
                <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🔒 Privacy &amp; Performance" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Control what gets analyzed and stored on your machine." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <CheckBox IsChecked="{Binding AutoRunOcr}" Content="Run offline Windows OCR on selection for instant text extraction" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox IsChecked="{Binding SaveHistory}" Content="Save query history in local SQLite database" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox IsChecked="{Binding SaveImagesInHistory}" Content="Save thumbnail images with history (disabled by default for privacy)" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox IsChecked="{Binding AutoSearchWeb}" Content="Allow automatic web search for products and errors" Margin="0,0,0,12" Foreground="{StaticResource TextPrimaryBrush}" />

                        <!-- Excluded Apps -->
                        <TextBlock Text="Excluded Applications (Blacklist)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding NewExcludedApp, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     Margin="0,0,8,0"
                                     ToolTip="Enter executable name (e.g. 1Password, KeePass)" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SubtleActionButtonStyle}"
                                    Command="{Binding AddExcludedAppCommand}"
                                    Height="32"
                                    Content="Add App" />
                        </Grid>

                        <ListBox ItemsSource="{Binding ExcludedApplications}" MaxHeight="100" Background="{StaticResource BgInputBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource CloseWindowButtonStyle}"
                                                Command="{Binding DataContext.RemoveExcludedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="20" Height="20">
                                            <TextBlock Text="✕" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 2: Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ModernActionButtonStyle}"
                    Command="{Binding SaveSettingsCommand}"
                    Content="Save Settings"
                    Width="120"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource SubtleActionButtonStyle}"
                    Click="OnCloseClick"
                    Content="Close"
                    Width="80" />
        </StackPanel>
    </Grid>
</Window>
