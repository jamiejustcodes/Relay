<Window x:Class="ScreenLens.UI.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenLens.UI.ViewModels"
        xmlns:controls="clr-namespace:ScreenLens.UI.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
        Title="Relay History"
        WindowStartupLocation="CenterScreen"
        Width="880" Height="620"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Body Split View -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" Background="{StaticResource AccentPrimaryBrush}" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="🕒" Foreground="#FFFFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Analysis History" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Browse your previous screen analyses and AI answers." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="38,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SubtleActionButtonStyle}"
                        Command="{Binding ClearAllCommand}"
                        Content="Clear All"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource SubtleActionButtonStyle}"
                        Click="OnCloseClick"
                        Content="Close" />
            </StackPanel>
        </Grid>

        <!-- 1: Split View (Master / Detail) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Master: History List -->
                <ColumnDefinition Width="340" />
                <!-- Splitter -->
                <ColumnDefinition Width="14" />
                <!-- Detail: Selected Item View -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Search & History List -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Input -->
                    <TextBox Grid.Row="0"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown"
                             Margin="0,0,0,10"
                             Height="34"
                             ToolTip="Search history... (Press Enter)" />

                    <!-- List of History Items -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        Background="{StaticResource BgCardBrush}"
                                        BorderBrush="{StaticResource GlassBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Line: Intent & Timestamp -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    HorizontalAlignment="Left"
                                                    Background="#206366F1"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding Intent}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryHoverBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Timestamp, StringFormat='{}{0:MM/dd HH:mm}'}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Middle Line: Title -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,3" />

                                        <!-- Bottom Line: App & Summary snippet -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding ApplicationName}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Detail View -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <!-- Empty State -->
                    <TextBlock Text="Select a history item to inspect."
                               Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding SelectedItem, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <!-- Item Details -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedItem, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Title & Actions -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SelectedItem.Title}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource SubtleActionButtonStyle}"
                                            Command="{Binding CopySelectedContentCommand}"
                                            Content="Copy"
                                            Margin="0,0,6,0" />
                                    <Button Style="{StaticResource CloseWindowButtonStyle}"
                                            Command="{Binding DeleteItemCommand}"
                                            CommandParameter="{Binding SelectedItem}">
                                        <TextBlock Text="🗑" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Origin & Context Line -->
                            <TextBlock Text="{Binding SelectedItem.ApplicationName}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="0,0,0,10" />

                            <!-- Executive Summary -->
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource GlassBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,14">
                                <TextBlock Text="{Binding SelectedItem.Summary}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Full Response Markdown -->
                            <controls:MarkdownViewerControl Markdown="{Binding SelectedItem.MarkdownResponse}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
